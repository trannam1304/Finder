{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{app/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.php"
    },
    {
      "source": "/admin/assets/:match*",
      "destination": "/public/admin/assets/:match*"
    },
    {
      "source": "/admin/:match*",
      "destination": "/api/index.php"
    },
    {
      "source": "/assets/:match*",
      "destination": "/public/assets/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/public/uploads/:match*"
    },
    {
      "source": "/favicon.svg",
      "destination": "/public/favicon.svg"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/:page.html",
      "destination": "/public/:page.html"
    },
    {
      "source": "/:page",
      "destination": "/public/:page.html"
    }
  ]
}
