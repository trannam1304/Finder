{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{app/**,public/**}"
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/admin/assets/(.*)$",
      "dest": "/public/admin/assets/$1"
    },
    {
      "src": "^/admin(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/public/assets/$1"
    },
    {
      "src": "^/uploads/(.*)$",
      "dest": "/public/uploads/$1"
    },
    {
      "src": "^/favicon\\.svg$",
      "dest": "/public/favicon.svg"
    },
    {
      "src": "^/$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/([^/]+\\.html)$",
      "dest": "/public/$1"
    },
    {
      "src": "^/([^/]+)$",
      "dest": "/public/$1.html"
    }
  ]
}
