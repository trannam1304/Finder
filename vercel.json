{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{app/**,public/**}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/public/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(app|database|tests|docs|\\.git)/(.*)",
      "status": 404
    },
    {
      "src": "/admin/assets/(.*)",
      "dest": "/public/admin/assets/$1"
    },
    {
      "src": "/admin/(.*\\.php)",
      "dest": "/api/index.php"
    },
    {
      "src": "/admin/?$",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/public/uploads/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/public/favicon.svg"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/([^/]+)\\.html",
      "dest": "/public/$1.html"
    },
    {
      "src": "/([^/]+)",
      "dest": "/public/$1.html"
    }
  ]
}
